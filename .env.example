# Copy this file to .env for local dev, and set the same values as
# environment variables in your Vercel project settings for deployment.

# Used by api/ai-proxy.js and the shared money agent (api/_lib/money-agent.js,
# powering both api/telegram-webhook.js and api/whatsapp-webhook.js) to call Claude.
ANTHROPIC_API_KEY=

# Telegram bot token, from @BotFather. Used by api/telegram-webhook.js and
# api/cron-summary.js to send/receive messages.
TELEGRAM_BOT_TOKEN=

# Shared secret for api/cron-summary.js — set this as a query param
# (?secret=...) on the cron job URL so random requests can't trigger it.
CRON_SECRET=

# Kite Connect app credentials (developers.kite.trade "My Apps"), used by
# api/kite-callback.js to exchange the login request_token for an access_token.
KITE_API_KEY=
KITE_API_SECRET=

# Shared secret for api/agent-message.js — a generic bridge into the money agent for
# an external bot that can't run on Vercel (e.g. a Baileys-based WhatsApp bot needing
# a persistent process). Callers must send it as `Authorization: Bearer <secret>`.
# Generate one with: openssl rand -hex 32
AGENT_BRIDGE_SECRET=

# Meta WhatsApp Cloud API (official, free), used by api/whatsapp-cloud-webhook.js.
# See the setup steps in that file's header comment.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
